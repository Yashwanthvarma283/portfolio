# Copy to .env.local (never commit real values)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The anon / publishable key only. Never put the service-role key here.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Vapi voice assistant (public key is browser-safe; restrict it to your domains in the Vapi dashboard)
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=
